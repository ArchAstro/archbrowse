{
  "name": "@archastro/archbrowse",
  "version": "0.1.0",
  "description": "A terminal browser you and your agents can control",
  "type": "module",
  "bin": {
    "archbrowse": "dist/cli.js",
    "starpane": "dist/cli.js",
    "react-kitty": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "tsx test/harness/run.ts",
    "check": "npm run typecheck && npm test && npm run test:e2e && npm run test:sessions && npm run test:agent",
    "prepack": "npm run build",
    "pretest:e2e": "npm run build && node scripts/prepare-pty.mjs",
    "test:native": "npm run build && tsx test/harness/native.ts",
    "test:sessions": "npm run build && node scripts/prepare-pty.mjs && tsx test/harness/persistence.ts",
    "pretest:herdr": "npm run build && node scripts/prepare-pty.mjs",
    "test:herdr": "tsx test/harness/herdr-run.ts",
    "test:agent": "npm run build && node scripts/prepare-pty.mjs && tsx test/harness/agent.ts",
    "test:skill": "node scripts/prepare-pty.mjs && tsx test/harness/skill.ts",
    "test:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "playwright-core": "^1.58.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "toml-eslint-parser": "^0.10.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pngjs": "^6.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "node-pty": "^1.1.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchAstro/archbrowse.git"
  },
  "homepage": "https://github.com/ArchAstro/archbrowse#readme",
  "bugs": {
    "url": "https://github.com/ArchAstro/archbrowse/issues"
  },
  "license": "MIT",
  "author": "ArchAstro Inc.",
  "keywords": [
    "terminal",
    "browser",
    "react",
    "kitty",
    "chromium",
    "agents",
    "herdr"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
